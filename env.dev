# DEV (dev-staging) environment.
# Run with:  npm run test:dev   (or: TEST_ENV=dev npx playwright test)
#
# Credentials are deliberately absent from this committed file — PASSWORD and the
# DB_USER/DB_PASSWORD below are real secrets. Supply them from your shell locally
# and from repo secrets in CI; envLoader gives OS/CI environment variables strict
# precedence over anything here (src/config/envLoader.ts).

# The web app is a static SPA host; the API is a SEPARATE host. Every path on
# app.ptdev.xyz returns index.html, so an API_URL of app.ptdev.xyz/api would
# silently resolve to HTML instead of JSON.
BASE_URL=https://app.ptdev.xyz
API_URL=https://api.ptdev.xyz/api

USER_NAME=su
TEST_DATA_SOURCE=json

# ── Test-user cleanup via SQL ───────────────────────────────────────────────
# PET Tiger can't delete a user through the UI or the API (the API has a DELETE
# route for nearly every other entity, but for users only /users/{id}/avatar), so
# SQL is the only way to actually remove one and free its Name/Initials/Email.
#
# DB_TRUSTED=no because Windows integrated auth (sqlcmd -E) only works when the
# run host shares an identity with the SQL host — true for the local/self-hosted
# setup, not for a GitHub-hosted runner. So a SQL login is used instead.
#
# DB_SERVER, DB_CLIENT, DB_USER and DB_PASSWORD are intentionally NOT set here:
# the first two vary per deployment and the last two are secrets. CI supplies all
# four (see .github/workflows/e2e.yml); locally put them in your gitignored .env.
# Without DB_SERVER and DB_CLIENT, isDbCleanupEnabled() returns false and cleanup
# skips with a logged warning rather than failing the run.
DB_CLEANUP=yes
DB_TRUSTED=no
