# DEV / staging environment — https://app.ptdev.xyz
# Run with:  npm run test:dev   (or: TEST_ENV=dev npx playwright test)
#
# USER_NAME / PASSWORD are deliberately absent: this file is committed.
# CI supplies them from repo secrets (PW_USER_NAME / PW_PASSWORD); locally,
# put them in the gitignored .env or export them in your shell. OS/CI env
# always wins over this file — see src/config/envLoader.ts.

# Origin only, no path: page objects navigate relatively (LoginPage.pageUrl
# is '/login'), and /dashboard is the post-login landing route, not the base.
BASE_URL=https://app.ptdev.xyz
API_URL=https://app.ptdev.xyz/api
TEST_DATA_SOURCE=json

# No SQL Server reachable from a GitHub-hosted runner — cleanup skips with a warning.
DB_CLEANUP=no
