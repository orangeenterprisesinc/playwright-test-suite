{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "tsconfig.json",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint/eslint-plugin"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "config/lint/.eslintrc.json",
    "playwright.config.ts",
    "dist",
    "node_modules",
    "artifacts"
  ],
  "rules": {
    "@typescript-eslint/interface-name-prefix": "off",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-empty-pattern": "warn"
  },
  "overrides": [
    {
      "files": [
        "tests/**/*.ts"
      ],
      "extends": [
        "plugin:playwright/recommended"
      ],
      "rules": {
        "playwright/no-conditional-in-test": "off",
        "playwright/no-conditional-expect": "off",
        "playwright/no-skipped-test": "off",
        "playwright/expect-expect": "off"
      }
    },
    {
      "files": [
        "src/fixtures/**/*.ts"
      ],
      "rules": {
        "no-empty-pattern": "off"
      }
    },
    {
      "files": [
        "tests/webpet/**/*.ts"
      ],
      "rules": {
        "playwright/no-networkidle": "off",
        "playwright/prefer-web-first-assertions": "off",
        "playwright/no-useless-not": "off",
        "playwright/no-wait-for-timeout": "off",
        "playwright/prefer-hooks-in-order": "off"
      }
    },
    {
      "files": ["tests/web/**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["@utils/relay/exportEnvelope", "@utils/relay/relayClient", "**/utils/relay/exportEnvelope", "**/utils/relay/relayClient"],
              "message": "A spec builds and sends no XML — go through @utils/journeys/*."
            },
            {
              "group": ["@utils/api/connectivityImportApi", "@utils/api/officeVerification", "**/utils/api/connectivityImportApi", "**/utils/api/officeVerification"],
              "message": "A spec imports and verifies nothing directly — go through @utils/journeys/*."
            },
            {
              "group": ["@data/generated", "@data/generated/*", "**/data/generated", "**/data/generated/*"],
              "message": "A spec mints no data — values come from src/data/<journey>/<spec-basename>.json via loadScenario()."
            }
          ]
        }]
      }
    }
  ]
}
