{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "tsconfig.json",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint/eslint-plugin"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "config/lint/.eslintrc.json",
    "playwright.config.ts",
    "dist",
    "node_modules",
    "artifacts"
  ],
  "rules": {
    "@typescript-eslint/interface-name-prefix": "off",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-empty-pattern": "warn"
  },
  "overrides": [
    {
      "files": [
        "tests/**/*.ts"
      ],
      "extends": [
        "plugin:playwright/recommended"
      ],
      "rules": {
        "playwright/no-conditional-in-test": "off",
        "playwright/no-conditional-expect": "off",
        "playwright/no-skipped-test": "off",
        "playwright/expect-expect": "off"
      }
    },
    {
      "files": [
        "tests/webpet/**/*.ts"
      ],
      "rules": {
        "playwright/no-networkidle": "warn",
        "playwright/prefer-web-first-assertions": "warn"
      }
    },
    {
      "files": ["tests/web/**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["@utils/api/*", "**/utils/api/*"],
              "message": "UI-first: a spec never touches the app's API — reads and allowed writes go through a flow in @utils/journeys/*."
            },
            {
              "group": ["@utils/relay/*", "**/utils/relay/*"],
              "message": "UI-first: device simulation lives in a flow, never in a spec."
            },
            {
              "group": ["@utils/cleanup/*", "**/utils/cleanup/*"],
              "message": "UI-first: cleanup is registered by the flow; a spec calls run.cleanup() at most."
            },
            {
              "group": ["@data/generated", "@data/generated/*", "**/data/generated", "**/data/generated/*"],
              "message": "A spec mints no data — values come from src/data/<journey>/<spec-basename>.json via loadScenario()."
            },
            {
              "group": ["@pages/webpet/*", "@fixtures/webpet*", "**/pages/webpet/*", "**/fixtures/webpet*"],
              "message": "The two page registries do not mix — journey specs use @fixtures/base.fixture and @pages/<area>/*."
            }
          ]
        }],
        "no-restricted-syntax": ["error", {
          "selector": "CallExpression[callee.object.name=/^(sessionApi|apiRequest)$/][callee.property.name=/^(post|put|patch|delete|fetch)$/]",
          "message": "UI-first: a spec never writes through the API context — the action belongs on screen, or in a flow under allowApiWrites()."
        }]
      }
    },
    {
      "files": ["src/utils/journeys/**/*.ts", "src/pages/!(webpet)/**/*.ts", "src/utils/fixtureRows/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["@pages/webpet/*", "@fixtures/webpet*", "**/pages/webpet/*", "**/fixtures/webpet*"],
              "message": "The two page registries do not mix. A shared component under components/webpet/* is fine — a page object or fixture is not."
            }
          ]
        }]
      }
    }
  ]
}
