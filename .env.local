# LOCAL — the containerized stack in docker/e2e/. Runbook: docker/e2e/README.md
# Bring it up first (npm run e2e:stack:db … :app), then: npm test
# Why any of this is set the way it is: docs/ENVIRONMENTS.md
#
# Ports are the stack's published ones: web/Caddy on 8090 (it also proxies /api),
# MinIO on 9000. The credentials are baked into the pulled DB image, not chosen
# here — see docker/e2e/compose.yml.

BASE_URL=http://localhost:8090
API_URL=http://localhost:8090/api

USER_NAME=su
PASSWORD=PetTigerE2E1!
TEST_DATA_SOURCE=json

# No DB config: test-data cleanup runs over the API, same as on dev staging.

# webpet suite only. S3_ENDPOINT un-gates employee-documents.spec.ts.
WEBPET_API_ORIGIN=http://localhost:8090
E2E_ADMIN_USER=su
E2E_ADMIN_PASSWORD=PetTigerE2E1!
S3_ENDPOINT=http://localhost:9000
