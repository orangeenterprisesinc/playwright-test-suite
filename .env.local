# LOCAL — full PET Tiger stack on this machine.  Run: npm test
# Why any of this is set the way it is: docs/ENVIRONMENTS.md
# Throwaway dev credentials only. OS/CI vars always override this file.

BASE_URL=http://localhost:3000
API_URL=http://localhost:8080/api

USER_NAME=su
PASSWORD=dev-local-su-password
TEST_DATA_SOURCE=json

# Cleanup: sqlcmd + Windows integrated auth (no stored password).
# For SQL auth instead: DB_TRUSTED=no plus DB_USER/DB_PASSWORD.
DB_CLEANUP=yes
DB_SERVER=localhost,1433
DB_CLIENT=DelLlano
DB_MASTER=TigerMaster
DB_TRUSTED=yes
# SQLCMD_PATH=C:\Program Files\Microsoft SQL Server\Client SDK\ODBC\180\Tools\Binn\SQLCMD.EXE

# webpet suite only. S3_ENDPOINT un-gates employee-documents.spec.ts.
E2E_ADMIN_USER=su
E2E_ADMIN_PASSWORD=dev-local-su-password
S3_ENDPOINT=http://localhost:9000
