# Mirrors .gitignore — plus node_modules, since the image installs its own
# Linux-native copy via `npm ci` rather than reusing whatever's on the host.
node_modules/

artifacts/
blob-report/
playwright/.cache/

playwright/.auth/
.auth/

# Personal secrets — never bake these into an image layer.
env/.env

.git/
.github/
.claude/

# Never ship these to the daemon as build context: the SQL backups are ~12.9GB
# of real client data and the screen recordings are tens of MB. Neither has any
# business in an image layer.
docker/db-backup/
docs/media/
