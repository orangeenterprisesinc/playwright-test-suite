# Copy to .env and fill in. Runbook: docker/e2e/README.md
#
# Only PT_TESTDB_IMAGE and WEBPET_DIR are machine-specific. The image's
# passwords are committed literals in compose.yml (see the comment there) —
# override them only if a future image changes them.

# Tag from: gh api "/orgs/orangeenterprisesinc/packages/container/pet-tiger-testdb/versions"
PT_TESTDB_IMAGE=ghcr.io/orangeenterprisesinc/pet-tiger-testdb:latest

# web-pet checkout the api/web images are built from. Absolute path.
WEBPET_DIR=C:/path/to/your/web-pet

# Optional overrides.
# PT_TESTDB_PORT=14333
# PT_TESTDB_MEMORY_MB=3072
# PT_TESTDB_SA_PASSWORD=Pet-Tiger-Test-1x
# PT_TESTDB_APP_PASSWORD=PetTigerTest1!
# PT_TESTDB_E2E_PASSWORD=PetTigerE2E1!
