<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<!--
  Offline first-run bypass for PET Pocket, discovered from AndroidPET source and
  verified on the emulator (see test-plans/journey-b/*.md, Preconditions):

  * PktWebMailDeviceAddress (non-empty) — MainMenuViewActivity.onCreate creates a
    dummy sync account when a device address exists, skipping the AuthenticatorActivity
    sign-in that otherwise gates the app (needs a live backend). Takes effect on the
    SECOND launch: the account is created after the check that reads it.
  * UseCrewMode=true + a valid CrewTimeInAlias — gates the Crew In button (an alias is
    "valid" when non-empty and not "None"/"Remove"). Button is GONE otherwise.
  * UseEmpHomeCrewDefVal=true — REQUIRED for a first-of-day Crew In: false routes the
    roster through getEmployeesByWorkCrew (members = today's existing time cards →
    empty on a fresh device → "No Employee belongs to this Crew"); true selects
    getEmployeesByHomeCrew, which reads the seeded Employee_Records.CREW.

  This file replaces the app's default shared_prefs wholesale
  (shared_prefs/com.orangesoftware.androidpet_preferences.xml), so every alias-gated
  button that should stay visible must be re-declared here — omitting one removes
  that button entirely.

  RestWebAddress (the relay URL the EXPORT button posts to) is injected at runtime by
  seedPrefs({ restWebAddress }) because the stub relay's port is dynamic.
-->
<map>
    <string name="PktWebMailDeviceAddress">b1device@petb1</string>
    <boolean name="UseCrewMode" value="true" />
    <boolean name="UseEmpHomeCrewDefVal" value="true" />
    <string name="CrewTimeInAlias">Crew In</string>
    <string name="CrewTimeOutAlias">Crew Out</string>
    <string name="TimeInAlias">Time-in</string>
    <string name="TimeInScreenLabelAlias">Time In</string>
    <string name="TimeOutAlias">Time-out</string>
    <string name="ExportAlias">Export</string>
    <string name="ImportAlias">Import</string>
    <string name="SyncAlias">Sync</string>
</map>
