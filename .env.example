# Template for .env.<name> files (.env.local / .env.dev / .env.qa).
# Select at runtime with TEST_ENV=<name> (default: local).
#
# Precedence: OS/CI vars > .env.<name> > .env      (src/config/envLoader.ts)
# Rationale, per-environment gotchas, and the full behaviour of every key below:
#   docs/ENVIRONMENTS.md
#
# Encrypting a value — any value here may be ENC(...) ciphertext:
#   npm run secret:keygen                    # once: generate SECRET_KEY
#   npm run secret:encrypt -- "myPassword"   # prints ENC(v1:...)
#   PASSWORD=ENC(v1:...)                     # paste it in
# getConfigValue() decrypts transparently. SECRET_KEY belongs ONLY in the
# gitignored .env (and CI secrets) — details: docs/adr/0006-encrypted-env-values.md
# SECRET_KEY=CHANGE_ME

# ── Application under test ──────────────────────────────────────────────────
# The API can be a SEPARATE host (see dev). A wrong API_URL returns HTML, not 404.
BASE_URL=http://localhost:3000
API_URL=http://localhost:8080/api

# Real secrets belong in CI secrets or your gitignored .env — not here.
USER_NAME=CHANGE_ME
PASSWORD=CHANGE_ME

# ── Test data ───────────────────────────────────────────────────────────────
TEST_DATA_SOURCE=json            # json | csv — read directly, no conversion
# RUNNER_DATA_DIR=src/data/runner            # override the runner-row directory
# DATA_FILE_PATH_JSON=src/data/runner/journey-a.json   # single-file escape hatch
# DATA_FILE_PATH_CSV=src/data/runner/journey-a.csv
# TEST_SCOPE=anthony-vineyards               # a file in config/scopes/; unset = all

# ── Run control ─────────────────────────────────────────────────────────────
# RETRY=1                        # default: CI 2, local 0
# MAX_FAILURES=5                 # stop the run after N failures
# WARMUP_TIMEOUT_MS=0            # 0 disables the app readiness probe

# ── Test-user cleanup via SQL (PET Tiger cannot delete a user) ──────────────
# DB_TRUSTED=yes → sqlcmd -E, Windows auth  |  no → mssql driver + DB_USER/PASSWORD
# Unset DB_SERVER or DB_CLIENT ⇒ cleanup skips with a warning, run still passes.
DB_CLEANUP=no                    # yes | no
DB_SERVER=localhost,1433         # host[,port] or host\INSTANCE
DB_CLIENT=CHANGE_ME              # client database holding app Users
DB_MASTER=CHANGE_ME              # master database holding global Users rows
DB_TRUSTED=yes
# DB_USER=CHANGE_ME              # only when DB_TRUSTED=no
# DB_PASSWORD=CHANGE_ME          # only when DB_TRUSTED=no
# SQLCMD_PATH=sqlcmd             # override if sqlcmd is not on PATH

# ── Email report (opt-in) ───────────────────────────────────────────────────
# Recipients route per branch+trigger from config/notifications/recipients.csv;
# EMAIL_TO is only the fallback. Edit the table, not this file.
# SEND_EMAIL=yes
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# EMAIL_FROM=qa-bot@example.com
# EMAIL_RECIPIENTS_FILE=config/notifications/recipients.csv
# EMAIL_TO=team@example.com,lead@example.com
# EMAIL_MAX_ATTACHMENT_MB=20     # oversized reports dropped for the run link

# ── Slack report (opt-in) ───────────────────────────────────────────────────
# SEND_SLACK=yes
# SLACK_WEBHOOK_URL=CHANGE_ME    # bearer-equivalent secret — encrypt or use CI

# ── S3 artifact upload (opt-in, CI-only) ────────────────────────────────────
# Report bucket must differ from the app's MinIO bucket and allow public read on
# automation-reports/*. REPORT_S3_URL is injected by CI — do not set it by hand.
# SEND_S3=yes
# S3_REPORT_BUCKET=CHANGE_ME
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ── Allure / ELK ────────────────────────────────────────────────────────────
# ALLURE_OWNER=QA                # "owner" label on every test
# SEND_RESULT_ELK=yes
# ELK_URL=CHANGE_ME

# ── API request auth (independent of the browser login) ─────────────────────
# AUTH_TYPE=oauth2               # oauth2 | basic | apikey | none (default)
# ACCESS_TOKEN_URL=CHANGE_ME
# CLIENT_ID=CHANGE_ME
# CLIENT_SECRET=CHANGE_ME
# AUTH_USERNAME=CHANGE_ME
# AUTH_PASSWORD=CHANGE_ME
# API_KEY=CHANGE_ME
# API_KEY_HEADER=X-API-Key

# ── Migrated web-pet suite (opt-in `webpet` project) ────────────────────────
# WEBPET_API_ORIGIN=https://api.ptdev.xyz   # dev only; UNSET on local (parity)
# E2E_ADMIN_USER=su
# E2E_ADMIN_PASSWORD=CHANGE_ME
# S3_ENDPOINT=http://localhost:9000         # non-empty un-gates employee-documents
