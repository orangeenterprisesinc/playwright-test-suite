# Template for .env.<name> files (.env.dev / .env.qa) — reference for every key.
# Select at runtime with TEST_ENV=<name> (default: local).
#
# QUICK START after a fresh clone: create a gitignored `.env` in the repo root
# with just these two lines, values from the 1Password item
# "PET Tiger — dev staging test logins", then `npm run test:dev`:
#   PASSWORD=<su password>
#   WEBPET_NONSU_PASSWORD=<non-su password>
# Everything else already lives in the committed .env.dev. Credentials are never
# committed — a team vault is the standard, not the repo.
#
# Precedence: OS/CI vars > .env.<name> > .env      (src/config/envLoader.ts)
# Rationale, per-environment gotchas, and the full behaviour of every key below:
#   docs/ENVIRONMENTS.md

# ── Application under test ──────────────────────────────────────────────────
# The API can be a SEPARATE host (see dev). A wrong API_URL returns HTML, not 404.
BASE_URL=https://app.ptdev.xyz
API_URL=https://api.ptdev.xyz/api

# Real secrets belong in CI secrets or your gitignored .env — not here.
USER_NAME=CHANGE_ME
PASSWORD=CHANGE_ME

# ── Test data ───────────────────────────────────────────────────────────────
TEST_DATA_SOURCE=json            # json | csv — read directly, no conversion
# RUNNER_DATA_DIR=src/data/runner            # override the runner-row directory
# DATA_FILE_PATH_JSON=src/data/runner/journey-a.json   # single-file escape hatch
# DATA_FILE_PATH_CSV=src/data/runner/journey-a.csv
# TEST_SCOPE=anthony-vineyards               # a file in config/scopes/; unset = all

# ── Run control ─────────────────────────────────────────────────────────────
# RETRY=1                        # default: CI 2, local 0
# MAX_FAILURES=5                 # stop the run after N failures
# WARMUP_TIMEOUT_MS=0            # 0 disables the app readiness probe
# SLOW_MO=400                    # ms per action; slows a run so its video is watchable

# ── Test-data cleanup ───────────────────────────────────────────────────────
# Nothing to configure. Records a test creates are deleted through the app's own
# API using the session auth-setup already established (API_URL + BASE_URL above).
# See src/utils/cleanup/cleanupRegistry.ts.

# ── Email report (DEPRECATED, opt-in) ───────────────────────────────────────
# Slack is the primary channel; email still works but is pinned off in CI.
# Recipients route per branch+trigger from config/notifications/recipients.csv;
# EMAIL_TO is only the fallback. Edit the table, not this file.
# SEND_EMAIL=yes
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# EMAIL_FROM=qa-bot@example.com
# EMAIL_RECIPIENTS_FILE=config/notifications/recipients.csv
# EMAIL_TO=team@example.com,lead@example.com
# EMAIL_MAX_ATTACHMENT_MB=20     # oversized reports dropped for the run link

# ── Slack report (primary channel, opt-in) ──────────────────────────────────
# Webhook = summary only (webhooks cannot carry files). Add a bot token +
# channel id (scopes: chat:write, files:write) and the reporter posts via
# chat.postMessage and uploads the Allure report into that message's thread.
#
# Slack is CI-only: on top of SEND_SLACK, the reporter posts only for the GitHub
# events in SLACK_NOTIFY_EVENTS, so a laptop run or a manual dispatch is silent
# no matter what is set here. Use SLACK_DRY_RUN=1 to see the payload locally.
# SEND_SLACK=yes
# SLACK_WEBHOOK_URL=CHANGE_ME    # bearer-equivalent secret — CI secrets or gitignored .env only
# SLACK_BOT_TOKEN=xoxb-CHANGE_ME # same
# SLACK_CHANNEL_ID=C0123456789
# SLACK_MAX_UPLOAD_MB=20         # oversized Allure reports are not uploaded
# SLACK_NOTIFY_EVENTS=schedule   # CSV of GitHub event names allowed to post
# SLACK_SUITE_NAME=User Journey  # report header; CI sets it per suite
# SLACK_EXECUTION_LABEL=Scheduled Dry Run   # derived from the trigger when unset
# SLACK_DRY_RUN=1                # log the payload instead of posting it

# ── S3 artifact upload (opt-in, CI-only) ────────────────────────────────────
# Report bucket must differ from the app's MinIO bucket and allow public read on
# automation-reports/*. REPORT_S3_URL and ALLURE_REPORT_URL are injected by CI —
# do not set them by hand.
# SEND_S3=yes
# S3_REPORT_BUCKET=CHANGE_ME
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ── Allure / ELK ────────────────────────────────────────────────────────────
# ALLURE_OWNER=QA                # "owner" label on every test
# SEND_RESULT_ELK=yes
# ELK_URL=CHANGE_ME

# ── API request auth (independent of the browser login) ─────────────────────
# AUTH_TYPE=oauth2               # oauth2 | basic | apikey | none (default)
# ACCESS_TOKEN_URL=CHANGE_ME
# CLIENT_ID=CHANGE_ME
# CLIENT_SECRET=CHANGE_ME
# AUTH_USERNAME=CHANGE_ME
# AUTH_PASSWORD=CHANGE_ME
# API_KEY=CHANGE_ME
# API_KEY_HEADER=X-API-Key

# ── Migrated web-pet suite (opt-in `webpet` project) ────────────────────────
# WEBPET_API_ORIGIN=https://api.ptdev.xyz   # dev only; UNSET on local (parity)
# E2E_ADMIN_USER=su
# E2E_ADMIN_PASSWORD=CHANGE_ME
# WEBPET_NONSU_PASSWORD=CHANGE_ME             # pairs with WEBPET_NONSU_USER in .env.dev; from 1Password
# S3_ENDPOINT=                              # non-empty un-gates employee-documents

# ── Journey B XML import tests ───────────────────────────────────────────────
# Post Office relay mailboxes: _FROM is the sending device, _SERVER the office
# queue it delivers to. The relay creates a mailbox on first use and the
# password is the account name, so there is nothing to provision.
# DEVICE_RELAY_SERVER=b1office@petb1
# DEVICE_RELAY_FROM=b1device@petb1
# DEVICE_RELAY_URL=https://orangeenterprises.azurewebsites.net/webmail/v6/OrangeMailService.svc

# Which route delivers the device export into the office:
#   internet (default) — Connectivity ▸ Import ▸ Internet, the relay pull Amy's
#     recording shows. Still gated on dev by WEBMAIL_LIVE_SEND_ENABLED plus a
#     ClientRelayRegistration row, so it cannot pass here yet.
#   single-folder — POST straight to the importer. Needs nothing from the relay,
#     so this is the route that proves a real import on dev today.
# IMPORT_TRANSPORT=single-folder

# How long to wait for an uploaded file to be parsed (default 60s). The worker
# claims queued files per client on the cadence in that client's
# SrvcRealTimeImportInterval preference (minutes — GET /api/preferences →
# serviceImportInterval), NOT on arrival, so this must exceed that interval. Dev
# was 15 min and is now 1; 180000 leaves headroom. Ask DevOps for
# PT_IMPORT_POLL_INTERVAL=10s on the API task to make the tick immediate — a
# preference change only applies from the next due time, an env override applies
# at boot.
# IMPORT_POLL_TIMEOUT_MS=180000

# Web-import unavailability FAILS the import verification by default — leave this
# unset to see the real failure. Set to 1 to create the same punches through the
# office API instead, so the office half is still verified when the import cannot
# run (demo/diagnostic only: the run is annotated and every row is asserted
# programCreated=false, so a substituted run can never read as a proven import).
# OFFICE_TRANSPORT_SUBSTITUTE=1
