# Build context for tools/video-annotator/Dockerfile.
#
# The Dockerfile COPYs only requirements.txt and the two .py files, but the
# whole directory is still transferred to the daemon first — and a local
# developer venv here is ~1.7 GB. Without this the build appears to hang on
# "sending build context".
.venv/
venv/
__pycache__/

# Generated by make_cursors.py, and only meaningful if they are real crops
# from your own recording. Mount them at runtime instead of baking them in.
cursors/

README.md
