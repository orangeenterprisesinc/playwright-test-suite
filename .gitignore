# Dependencies
node_modules/

# All run output — Playwright results/HTML report, Allure results/report, and
# the framework logs — lives under one tree (see docs/STRUCTURE.md).
/artifacts/
/blob-report/
/playwright/.cache/

# Debug screenshots from the migrated web-pet specs (select-smoke.spec.ts,
# mobile-tab-labels.spec.ts). They hardcode a relative 'e2e/.screenshots/...'
# path, which resolved under apps/web/ in the source repo but resolves to this
# repo's root here — so the specs create a stray top-level e2e/ folder. Nothing
# asserts on these; they are eyeball aids. The source repo ignores the same
# output (its .gitignore: apps/web/e2e/.screenshots/).
/e2e/

# Auth storage state (contains session cookies — never commit)
/playwright/.auth/
.auth/

# Personal env overrides (SMTP credentials etc.) — loaded by envLoader as the
# base file, never committed. The committed .env.local/.dev/.qa hold no real
# plaintext secrets: anything sensitive there is stored as ENC(...) ciphertext
# and decrypted at read time (see src/config/secrets.ts). The master key
# SECRET_KEY lives HERE, in this untracked file, and in CI secrets — never in a
# committed file, or the encryption buys nothing.
.env
# ...but never ignore the committed per-environment files or the template.
!.env.example
!.env.local
!.env.dev
!.env.qa

# Claude Code — the shared .claude/ folder IS committed; only personal
# local overrides are ignored.
.claude/settings.local.json

#Testing context — screen recordings referenced by the plans under test-plans/
docs/media/
Reference project/

# NOTE: package-lock.json is intentionally tracked — CI uses `npm ci`,
# which requires it.


# Local SQL Server backup (12.9GB real client data — never commit)
docker/db-backup/
*.bak
docker/e2e/.env
