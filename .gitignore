# Dependencies
node_modules/

# Playwright output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Debug screenshots from the migrated web-pet specs (select-smoke.spec.ts,
# mobile-tab-labels.spec.ts). They hardcode a relative 'e2e/.screenshots/...'
# path, which resolved under apps/web/ in the source repo but resolves to this
# repo's root here — so the specs create a stray top-level e2e/ folder. Nothing
# asserts on these; they are eyeball aids. The source repo ignores the same
# output (its .gitignore: apps/web/e2e/.screenshots/).
/e2e/

# Auth storage state (contains session cookies — never commit)
/playwright/.auth/
.auth/

# Personal env overrides (SMTP credentials etc.) — loaded by envLoader as the
# base file, never committed. Committed env.local/dev/qa hold no real secrets.
.env

# Reporting output
allure-results/
allure-report/
logs/

# Claude Code — the shared .claude/ folder IS committed; only personal
# local overrides are ignored.
.claude/settings.local.json

#Testing context
Testing video/
Reference project/

# NOTE: package-lock.json is intentionally tracked — CI uses `npm ci`,
# which requires it.


# Local SQL Server backup (12.9GB real client data — never commit)
db backup/
*.bak
docker-e2e/.env
