# Dependencies
node_modules/

# All run output — Playwright results/HTML report, Allure results/report,
# debug screenshots, and the framework logs — lives under one tree
# (see docs/STRUCTURE.md).
/artifacts/
/blob-report/
/playwright/.cache/

# Playwright/Allure DEFAULT output dirs. Nothing writes here when the
# configured chain runs, but a CLI `--reporter=html` override or an Allure
# option typo falls back to these defaults — keep them un-committable.
/test-results/
/playwright-report/
/allure-results/
/allure-report/

# Local-only tooling and its generated output — never commit
# (see .claude/GITHUB_WORKFLOW.md "never commit local noise").
# tools/video-annotator/ is the one tracked tool; its venv, generated cursor
# templates and output stay local (see tools/video-annotator/README.md).
/tools/*
!/tools/video-annotator/
/tools/video-annotator/.venv/
/tools/video-annotator/cursors/
/.video-annotations/
/inviestgate/

# Auth storage state (contains session cookies — never commit)
/playwright/.auth/
.auth/

# Personal env overrides and real credentials — loaded by envLoader as the base
# file, never committed. The committed .env.local/.dev/.qa carry no secrets.
.env
# ...but never ignore the committed per-environment files or the template.
!.env.example
!.env.local
!.env.dev
!.env.qa

# Claude Code — the shared .claude/ folder IS committed; only personal
# local overrides are ignored.
.claude/settings.local.json

#Testing context — screen recordings referenced by the plans under test-plans/
docs/media/
Reference project/

# NOTE: package-lock.json is intentionally tracked — CI uses `npm ci`,
# which requires it.


# Local SQL Server backups (12.9GB real client data — never commit). No longer
# part of the stack: docker/e2e/ pulls a pre-baked DB image instead. Kept on disk
# only as a fallback while the image's thinner PetData is being evaluated.
docker/db-backup/
*.bak
docker/e2e/.env
