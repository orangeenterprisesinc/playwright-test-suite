# Mirrors .gitignore — plus node_modules, since the image installs its own
# Linux-native copy via `npm ci` rather than reusing whatever's on the host.
node_modules/

test-results/
playwright-report/
blob-report/
playwright/.cache/

playwright/.auth/
.auth/

# Personal secrets — never bake these into an image layer.
.env

allure-results/
allure-report/
logs/

.git/
.github/
.claude/

# Video annotator — none of this belongs in the Playwright image's build
# context, and the venv alone is ~1.7 GB, which the daemon would otherwise
# transfer on every `npm run docker:build`. The annotator has its own
# Dockerfile at tools/video-annotator/Dockerfile, built from that directory
# as its own context.
tools/video-annotator/.venv/
tools/video-annotator/cursors/
.video-annotations/

# Source recordings and SQL backups — gitignored, large, and never needed by
# any image.
Testing video/
db backup/
*.bak
