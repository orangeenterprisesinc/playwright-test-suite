# Template for env.<name> files (env.local / env.dev / env.qa).
# Copy to env.<name> and fill in the values for that environment.
# Select at runtime with TEST_ENV=<name> (defaults to 'local').
#
# Precedence (src/config/envLoader.ts):
#   1. OS/CI environment variables (never overridden — CI secrets win)
#   2. env.<name> file
#   3. .env file (optional shared base)

# Application under test. BASE_URL and API_URL are not always the same host —
# dev staging serves the SPA from app.ptdev.xyz and the API from
# api.ptdev.xyz/api (see env.dev). Where they differ, every path on the SPA host
# returns index.html, so a wrong API_URL yields HTML instead of JSON rather than
# a clean 404.
BASE_URL=http://localhost:3000
API_URL=http://localhost:8080/api

# Application login credentials — real secrets belong in CI secret stores
# or your local shell, NOT in committed env files.
USER_NAME=CHANGE_ME
PASSWORD=CHANGE_ME

# Test data source: 'json' | 'csv' (read directly, no conversion)
# Runner rows live one file per journey in src/data/runner/; this picks which
# format is read. The CSV is authored and the JSON is its generated mirror
# (npm run runner:sync), so both hold the same rows.
TEST_DATA_SOURCE=json

# Optional: override the runner-row directory (default src/data/runner).
# RUNNER_DATA_DIR=src/data/runner

# Optional: read a single data file instead of the per-journey directory — an
# escape hatch for running against one hand-made file. Unset by default.
# DATA_FILE_PATH_JSON=src/data/runner/journey-a.json
# DATA_FILE_PATH_CSV=src/data/runner/journey-a.csv

# Optional: restrict the run to one customer's scope — a file in src/data/scopes/.
# A workflow runs only if its segments include one of the customer's AND all its
# licence modules are enabled for them (see src/config/scope.ts). Unset means no
# filtering, which is the default and runs every workflow.
# TEST_SCOPE=anthony-vineyards

# Optional: override retry count (defaults: CI=2, local=0)
# RETRY=1

# Optional: email a run summary after each execution (off by default).
# Real SMTP credentials belong in CI secrets or your local shell.
# SEND_EMAIL=yes
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# EMAIL_FROM=qa-bot@example.com
# EMAIL_TO=team@example.com,lead@example.com
# Max size (MB) per report zip attached to the email; oversized ones are
# dropped in favor of the CI run link. Defaults to 20 (safely under Gmail's
# ~25MB attachment cap after base64 overhead).
# EMAIL_MAX_ATTACHMENT_MB=20

# Optional: post a run summary to Slack after each execution (off by default).
# SLACK_WEBHOOK_URL is a secret (Slack Incoming Webhook) — never commit the
# real value; keep it in CI secrets or your local shell.
# SEND_SLACK=yes
# SLACK_WEBHOOK_URL=CHANGE_ME

# Optional: upload the raw test-results (traces, videos, screenshots) to a public
# S3 bucket after each run and link them in the Slack message (off by default,
# CI-only — see .github/workflows/e2e.yml). Use a report bucket distinct from the
# app's MinIO S3_BUCKET; the bucket must allow public read on automation-reports/*
# via a bucket policy. AWS_* are secrets — keep them in CI secrets, never commit.
# REPORT_S3_URL is injected by CI (the deterministic per-run URL); do not set it
# by hand.
# SEND_S3=yes
# S3_REPORT_BUCKET=CHANGE_ME
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Optional: "owner" label shown on every test in the Allure report (default: QA).
# ALLURE_OWNER=QA

# Optional: push a run summary to an ELK/Elasticsearch ingest endpoint (off by default).
# SEND_RESULT_ELK=yes
# ELK_URL=CHANGE_ME

# Optional: API request authentication — only relevant to apiRequest/api.fixture
# calls, independent of the Keycloak browser login above. Defaults to 'none'.
# AUTH_TYPE=oauth2               # oauth2 | basic | apikey | none
# ACCESS_TOKEN_URL=CHANGE_ME
# CLIENT_ID=CHANGE_ME
# CLIENT_SECRET=CHANGE_ME
# AUTH_USERNAME=CHANGE_ME
# AUTH_PASSWORD=CHANGE_ME
# API_KEY=CHANGE_ME
# API_KEY_HEADER=X-API-Key

# ── Test-user cleanup via SQL ───────────────────────────────────────────────
# PET Tiger cannot delete a user — no UI action, and no DELETE route on the API
# either (it has one for nearly every other entity, but for users only
# /users/{id}/avatar). So SQL is the only way to remove a test user and free its
# Name/Initials/Email, and tests that create users depend on it.
#
# DB_TRUSTED picks BOTH the auth mode and, as a consequence, the transport:
#
#   DB_TRUSTED=yes → sqlcmd CLI with -E (Windows integrated auth). No credentials
#                    needed, but only works where the run host shares an identity
#                    with the SQL host, and requires sqlcmd installed. Used for
#                    local runs and the self-hosted e2e-local.yml.
#   DB_TRUSTED=no  → the `mssql` driver (pure JS, arrives with npm ci) using
#                    DB_USER/DB_PASSWORD. No CLI needed, so this is what works on
#                    GitHub-hosted runners. Used for dev staging.
#
# The split exists because tedious (which mssql wraps) can't do true Windows
# integrated auth, and a Linux CI runner has no Windows identity anyway.
# SQLCMD_PATH only matters on the trusted path.
#
# Either way the run host still needs a network route to the database. Where
# there is none, cleanup skips with a warning and the run passes — but the users
# it created are left behind, so on shared environments they accumulate.
# global-setup.ts probes the connection once at the start of a run and reports it
# loudly (a ::error:: annotation in CI) rather than letting that go unnoticed.
DB_CLEANUP=no                    # yes | no
DB_SERVER=localhost,1433         # host[,port] or host\INSTANCE
DB_CLIENT=CHANGE_ME              # client/tenant database holding app Users
DB_MASTER=CHANGE_ME              # master database holding global Users rows
DB_TRUSTED=yes                   # yes = Windows integrated auth (sqlcmd -E)
# DB_USER=CHANGE_ME              # only when DB_TRUSTED=no
# DB_PASSWORD=CHANGE_ME          # only when DB_TRUSTED=no
# SQLCMD_PATH=sqlcmd             # override if sqlcmd is not on PATH
