{
  "name": "playwright-pom-core",
  "version": "1.0.0",
  "description": "Playwright + TypeScript POM test framework for PET Tiger",
  "scripts": {
    "test": "node scripts/run-playwright.js local",
    "test:dev": "node scripts/run-playwright.js dev",
    "test:qa": "node scripts/run-playwright.js qa",
    "test:headed": "node scripts/run-playwright.js local --project=chromium --headed",
    "test:ui": "node scripts/run-playwright.js local --ui",
    "test:debug": "node scripts/run-playwright.js local --project=chromium --debug",
    "test:device": "node scripts/run-playwright.js dev --project=device",
    "device:setup:sdk": "powershell -ExecutionPolicy Bypass -File scripts/device/setup-android-sdk.ps1",
    "device:build:apk": "powershell -ExecutionPolicy Bypass -File scripts/device/build-apk.ps1",
    "device:driver": "node scripts/device/install-appium-driver.mjs",
    "device:fixtures": "node --import tsx scripts/device/make-golden-db.ts",
    "test:smoke": "node scripts/run-playwright.js local --grep=@Smoke",
    "test:high-level": "node scripts/run-playwright.js local --grep=@HighLevel",
    "test:regression": "node scripts/run-playwright.js local --grep=@Regression",
    "test:api": "node scripts/run-playwright.js local --project=api",
    "test:workflow": "node scripts/run-playwright.js local --grep=@Workflow",
    "test:last-failed": "node scripts/run-playwright.js local --last-failed",
    "test:webpet": "node scripts/run-playwright.js local --project=webpet",
    "test:webpet:headed": "node scripts/run-playwright.js local --project=webpet --headed",
    "test:webpet:dev": "node scripts/run-playwright.js dev --project=webpet",
    "test:webpet:debug": "node scripts/run-playwright.js local --project=webpet --debug",
    "test:webpet:ui": "node scripts/run-playwright.js local --project=webpet --ui",
    "test:webpet:list": "node scripts/run-playwright.js local --project=webpet --list --reporter=list",
    "test:webpet:smoke": "node scripts/run-playwright.js local --project=webpet --grep=@wp-smoke",
    "test:webpet:last-failed": "node scripts/run-playwright.js local --project=webpet --last-failed",
    "webpet:runner:sync": "node scripts/webpet/runner-sync.js",
    "webpet:runner:check": "node scripts/webpet/runner-sync.js --check",
    "webpet:runner:mirror": "node scripts/webpet/runner-sync.js --mirror",
    "webpet:runner:ids": "node scripts/webpet/runner-sync.js --ids",
    "webpet:ids:check": "node scripts/webpet/ids-check.js",
    "webpet:skip-gate": "node scripts/webpet/skip-gate.js",
    "webpet:audit": "node scripts/webpet/audit-relocation.js",
    "lint": "eslint --config config/lint/.eslintrc.json --resolve-plugins-relative-to . \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint --config config/lint/.eslintrc.json --resolve-plugins-relative-to . \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --config config/lint/.prettierrc.json --write",
    "webpet:baseline": "node scripts/webpet/baseline.js",
    "webpet:diff": "node scripts/webpet/baseline-diff.js",
    "secret:keygen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/config/secret.ts keygen",
    "secret:encrypt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/config/secret.ts encrypt",
    "secret:decrypt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/config/secret.ts decrypt",
    "catalog:import": "node scripts/catalog/import-catalog.js",
    "runner:sync": "node scripts/runner/sync.js",
    "runner:check": "node scripts/runner/check.js",
    "coverage:catalog": "node scripts/runner/coverage.js",
    "docker:build": "docker build -f docker/Dockerfile -t playwright-test-suite .",
    "docker:run": "docker run --rm -e BASE_URL -e API_URL -e USER_NAME -e PASSWORD -e TEST_ENV -v \"%cd%/artifacts:/app/artifacts\" playwright-test-suite",
    "test:report": "node node_modules/@playwright/test/cli.js show-report artifacts/html",
    "notify:reminder": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/notify/slack-reminder.ts",
    "report:allure": "node scripts/report/allure-generate.js",
    "report:allure:open": "node scripts/report/allure-open.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "keywords": [],
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.53",
    "@playwright/test": "1.58.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.2.2",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "appium": "^2.19.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.5.1",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.3",
    "playwright": "1.58.2",
    "playwright-core": "1.58.2",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "webdriverio": "^9.30.1"
  }
}
