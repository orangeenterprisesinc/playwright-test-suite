{
  "mcpServers": {
    "playwright-test": {
      "command": "node",
      "args": [
        "node_modules/@playwright/test/cli.js",
        "run-test-mcp-server"
      ]
    },
    "jira": {
      "command": "mcp-atlassian",
      "args": [],
      "env": {
        "JIRA_URL": "${JIRA_URL}",
        "JIRA_USERNAME": "${JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "TOOLSETS": "jira_issues,jira_comments,jira_fields,jira_projects,jira_links,jira_transitions,jira_attachments,jira_users,jira_agile"
      }
    },
    "datadog": {
      "type": "http",
      "url": "https://mcp.us3.datadoghq.com/v1/mcp"
    }
  }
}
