# DEV (dev-staging).  Run: npm run test:dev
# Why any of this is set the way it is: docs/ENVIRONMENTS.md
# Credentials are 1Password secret references, resolved at load time by the
# 1Password CLI's desktop-app integration (src/config/envLoader.ts). CI injects
# the real values as job env, which wins over these. A literal for the same key
# in the gitignored .env also overrides the reference.

# API is a SEPARATE host (a wrong API_URL returns HTML, not a 404)
BASE_URL=https://app.ptdev.xyz
API_URL=https://api.ptdev.xyz/api

USER_NAME=su
PASSWORD=op://Shared/PET Tiger dev staging test logins/su_password
TEST_DATA_SOURCE=json

# No DB config: test-data cleanup runs over the app's API (DELETE /users/{id}).
# Dev staging's SQL Server is VPC-private and stays that way.

# webpet suite only. Unset on local (Vite proxy = source-repo parity).
# E2E_ADMIN_PASSWORD + S3_ENDPOINT absent on purpose.
WEBPET_API_ORIGIN=https://api.ptdev.xyz
E2E_ADMIN_USER=su

# Post Office relay the Journey B XML import tests post envelopes to (the same
# mailboxes a PET Pocket device would use). The relay has no accounts — an
# address is a queue key created on use, password == account name; @petb1 keeps
# ours off the shared @usesilo pool.
DEVICE_RELAY_SERVER=b1office@petb1
DEVICE_RELAY_FROM=b1qadevice@petb1
DEVICE_RELAY_URL=https://orangeenterprises.azurewebsites.net/webmail/v6/OrangeMailService.svc

# Non-SU login for WP-0408 (WEBPET-2006 third gate term).
WEBPET_NONSU_USER=E2ENonSU
WEBPET_NONSU_PASSWORD=op://Shared/PET Tiger dev staging test logins/nonsu_password
